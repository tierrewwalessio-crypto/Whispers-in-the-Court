+class Startup(TestCase):
+    def test_game_ack_is_processed_while_ai_check_is_still_waiting(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            p=Path(tmp);cfg=config.Config(user_dir=str(p),mod_dir=str(p/'mod'))
+            client=Mock(NAME='Slow AI',up=None)
+            entered, release=threading.Event(),threading.Event()
+            def health():
+                entered.set();release.wait(5);return False
+            client.is_up.side_effect=health
+            with patch('courtbrain.app.make_client',return_value=client),patch('courtbrain.config.user_dir_candidates_found',return_value=[]):
+                brain=CourtBrain(cfg);brain.log=Mock()
+                brain._worker=Mock()  # no story tasks or inference in the test
+                try:
+                    start=time.monotonic();brain.start()
+                    self.assertLess(time.monotonic()-start,1.0)
+                    self.assertTrue(entered.wait(1))
+                    self.assertTrue((cfg.run_path/'votc_nd85en_poll.txt').is_file())
+                    self.assertFalse(release.is_set())
+                    with (p/'console_history.txt').open('a',encoding='utf-8') as f:
+                        f.write('votc_say ACK|mail=1|loc=0|nodebug=1|achievements=1|transport=nd85en|mod=8502\n')
+                    brain.tick()
+                    self.assertTrue(brain.game_seen)
+                    self.assertEqual(brain._achievement_status,'1')
+                    self.assertFalse(release.is_set())
+                finally:
+                    brain.stop();release.set()
+
+    def test_ai_check_exception_is_reported_without_stopping_bridge(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            cfg=config.Config(user_dir=tmp,mod_dir=str(Path(tmp)/'mod'))
+            client=Mock(NAME='Broken AI',up=None)
+            client.is_up.side_effect=RuntimeError('metadata failure')
+            with patch('courtbrain.app.make_client',return_value=client),patch('courtbrain.config.user_dir_candidates_found',return_value=[]):
+                brain=CourtBrain(cfg);messages=[];brain.log=messages.append;brain._worker=Mock()
+                try:
+                    brain.start()
+                    deadline=time.monotonic()+1
+                    while client.up is not False and time.monotonic()<deadline: time.sleep(.01)
+                    self.assertIs(client.up,False)
+                    self.assertTrue(any('Connection check failed for Broken AI' in s for s in messages))
+                    self.assertTrue((cfg.run_path/'votc_nd85en_poll.txt').is_file())
+                finally: brain.stop()
