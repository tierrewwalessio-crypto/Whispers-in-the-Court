+class Transport(unittest.TestCase):
+    def render(self, value, key='votc_out_body'):
+        """Resolve the generated static fragments, independent of the encoder."""
+        variables = {}
+        for line in text.encode({key: value}):
+            m = re.fullmatch(r'set_global_variable = \{ name = (\w+) value = "flag:(.*)" \}', line)
+            if m:
+                # Match the engine: raw flag names lose boundary whitespace.
+                variables[m[1]] = m[2].strip()
+        loc = (bundle.mod_source() / 'main_menu/localization/russian/votc_nd_text_l_russian.yml').read_text(encoding='utf-8-sig')
+        keys = dict(re.findall(r'^ (\w+):0 "(.*)"$', loc, re.M))
+        ident = text.manifest()['keys'][key]['id']
+        body = keys[f'vnd_{ident}_live']
+        body = re.sub(r'\$(\w+)\$', lambda m: keys[m[1]], body)
+        body = re.sub(r"\[GetGlobalVariable\('([^']+)'\).GetFlagName\]", lambda m: keys.get(variables[m[1]], variables[m[1]]), body)
+        return body.replace('\\n', '\n').replace('\\"', '"').replace('\\\\', '\\')
+
+    def test_punctuation_quotes_paragraphs_and_long_text(self):
+        for value in (LONG_TEXT, SHORT_TEXT, 'ENG', 'yes', '1.5: "Да"; путь C:\\Games\\EU5', 'A' * 150, '  Совет, посол; затем: мир. Следующий день.  ',
+                      'С' * 159 + ' ' + 'два слова ' * 40, '"  Да  "',
+                      'Символы [пример] #test $name$ — безопасный текст'):
+            self.assertEqual(self.render(value), text.prose(value))
